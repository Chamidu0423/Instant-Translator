{
  "manifest_version": 3,
  "name": "Instant Translator",
  "description": "Instantly translate text on any webpage by selecting or hovering. Professional, fast, and privacy-friendly.",
  "version": "1.0",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
